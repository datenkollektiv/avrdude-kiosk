{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(.env)", "Read(**/.env)",
      "Read(.env.*)", "Read(**/.env.*)",
      "Read(*.pem)", "Read(**/*.pem)",
      "Read(*.key)", "Read(**/*.key)",
      "Read(secrets/**)", "Read(**/secrets/**)",
      "Edit(./.devcontainer/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.mcp.json)",
      "Edit(./.git/**)"
    ]
  }
}
